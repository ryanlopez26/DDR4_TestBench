# set_property -dict {PACKAGE_PIN AM13 IOSTANDARD SSTL12_DCI}      [get_ports {ddr4_sdram_cs_n[1]}]
# set_property -dict {PACKAGE_PIN AK13 IOSTANDARD SSTL12_DCI}      [get_ports {ddr4_sdram_odt[1]}]
# set_property -dict {PACKAGE_PIN AJ9  IOSTANDARD DIFF_SSTL12_DCI} [get_ports {ddr4_sdram_ck_t[1]}]
# set_property -dict {PACKAGE_PIN AK9  IOSTANDARD DIFF_SSTL12_DCI} [get_ports {ddr4_sdram_ck_c[1]}]
